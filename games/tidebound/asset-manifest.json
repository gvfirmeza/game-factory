{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "gameId": "tidebound",
  "title": "Tidebound",
  "version": "1.0.0",
  "viewport": {
    "width": 720,
    "height": 450,
    "aspectRatio": "16:9",
    "pixelRatio": 1,
    "letterbox": true
  },
  "palette": {
    "hero": {
      "body": "#2EC4B6",
      "bodyShade": "#20A396",
      "cape": "#80ED99",
      "capeShadow": "#57CC99",
      "beret": "#FFD166",
      "beretRidge": "#F4A261",
      "antennaPearl": "#E0FBFC",
      "antennaGlow": "#00F5D4",
      "blush": "rgba(255, 138, 174, 0.45)",
      "eyes": "#1D3557",
      "catchlight": "#FFFFFF"
    },
    "enemies": {
      "hermitScuttler": {
        "shell": "#E76F51",
        "shellRidge": "#F4A261",
        "body": "#2A9D8F",
        "claws": "#F4A261",
        "eyes": "#1D3557"
      },
      "spinyUrchin": {
        "body": "#1D3557",
        "bodyDeep": "#0B092B",
        "spikes": "#48CAE4",
        "glow": "#00F5D4",
        "eyes": "#00F5D4"
      },
      "bubbleRay": {
        "bodyTop": "#00F5D4",
        "bodyMid": "#48CAE4",
        "bodyBase": "#0077B6",
        "belly": "rgba(202, 240, 248, 0.6)",
        "halo": "rgba(0, 245, 212, 0.25)",
        "eyes": "#1D3557"
      },
      "coralCrusher": {
        "armorTop": "#D62828",
        "armorBase": "#9B2226",
        "spikes": "#E76F51",
        "legs": "#780000",
        "claw": "#D62828",
        "eyesNormal": "#FDFFFC",
        "eyesAlert": "#FFD166",
        "dazedStars": "#FFD166"
      }
    },
    "boss": {
      "golem": {
        "stoneTop": "#577590",
        "stoneMid": "#264653",
        "stoneDark": "#1B3039",
        "coralGrowth": "#E76F51",
        "coralEnraged": "#D62828",
        "pearlCore": "#E0FBFC",
        "coreGlow": "#00F5D4",
        "runesNormal": "#00F5D4",
        "runesEnraged": "#F77F00",
        "eyes": "#00F5D4"
      }
    },
    "npcs": {
      "coralia": {
        "fur": "#78593F",
        "belly": "#FCEADE",
        "snorkel": "#E9C46A",
        "goggles": "#38BDF8",
        "necklace": "#FFD166"
      },
      "barnaby": {
        "shell": "#2A9D8F",
        "shellShade": "#264653",
        "skin": "#52B788",
        "hat": "#264653",
        "hatGold": "#FFD166",
        "spectacles": "#FFD166"
      },
      "beaconKeeper": {
        "body": "#E0FBFC",
        "wingTrim": "#00F5D4",
        "diadem": "#FFD166",
        "halo": "rgba(0, 245, 212, 0.4)",
        "eyes": "#03045E"
      }
    },
    "biomes": {
      "palmBeach": {
        "skyTop": "#56B4D3",
        "skyBottom": "#E4F5FC",
        "sandLight": "#FCEADE",
        "sandMain": "#F4A261",
        "sandDark": "#E76F51",
        "palms": "#2A9D8F",
        "water": "rgba(46, 196, 182, 0.65)"
      },
      "overgrownRuins": {
        "skyTop": "#1E3A34",
        "skyBottom": "#112421",
        "stoneLight": "#577590",
        "stoneMain": "#264653",
        "stoneDark": "#1B3039",
        "moss": "#43AA8B",
        "trim": "#2EC4B6"
      },
      "floodedCaves": {
        "skyTop": "#0B092B",
        "skyBottom": "#0D1B2A",
        "rockMain": "#1B263B",
        "rockDark": "#0D1B2A",
        "coralCyan": "#00F5D4",
        "coralViolet": "#9B5DE5",
        "waterLagoon": "rgba(3, 4, 94, 0.75)"
      },
      "windCliffs": {
        "skyTop": "#1D3557",
        "skyBottom": "#0077B6",
        "cliffSlate": "#3D5A80",
        "cloudWhite": "#FFFFFF",
        "sunsetGold": "#F77F00",
        "windStream": "rgba(202, 240, 248, 0.35)"
      },
      "lighthouseIsland": {
        "skyTop": "#03045E",
        "skyBottom": "#240046",
        "coliseumMarble": "#FDFFFC",
        "coliseumGold": "#FFD166",
        "beaconCyan": "#4CC9F0",
        "beaconAmber": "#FFB703"
      }
    }
  },
  "protagonist": {
    "id": "cori",
    "name": "Cori the Reef Sprite",
    "dimensions": { "width": 24, "height": 32 },
    "hitbox": { "width": 18, "height": 26 },
    "renderFunction": "drawCori",
    "animations": {
      "idle": { "fps": 6, "loop": true, "squash": 0.03 },
      "run": { "fps": 14, "loop": true, "bounce": 0.08 },
      "jumpAscend": { "scaleX": 0.85, "scaleY": 1.20 },
      "jumpApex": { "scaleX": 1.05, "scaleY": 0.95 },
      "jumpFall": { "scaleX": 0.90, "scaleY": 1.15 },
      "dash": { "scaleX": 1.35, "scaleY": 0.75, "duration": 0.18 },
      "stompBounce": { "scaleX": 1.40, "scaleY": 0.65 },
      "hurt": { "flashHz": 10, "duration": 1.5 }
    }
  },
  "enemies": [
    {
      "id": "hermit_scuttler",
      "name": "Hermit Scuttler",
      "archetype": "patrol_walker",
      "dimensions": { "width": 20, "height": 22 },
      "renderFunction": "drawHermitScuttler",
      "animations": {
        "walk": { "fps": 18, "legWiggle": 3 },
        "die": { "spinArc": true, "duration": 0.6 }
      }
    },
    {
      "id": "spiny_urchin",
      "name": "Spiny Urchin",
      "archetype": "rhythmic_hopper",
      "dimensions": { "width": 22, "height": 24 },
      "renderFunction": "drawSpinyUrchin",
      "animations": {
        "idle": { "spikePulse": 2.5 },
        "squashTelegraph": { "scaleX": 1.30, "scaleY": 0.70, "duration": 0.25 },
        "hop": { "scaleX": 0.85, "scaleY": 1.25 }
      }
    },
    {
      "id": "bubble_ray",
      "name": "Bubble Ray Flyer",
      "archetype": "sine_flyer",
      "dimensions": { "width": 24, "height": 18 },
      "renderFunction": "drawBubbleRay",
      "animations": {
        "fly": { "wingFlapHz": 7, "tailWaveHz": 10 }
      }
    },
    {
      "id": "coral_crusher",
      "name": "Coral Crusher Crab",
      "archetype": "proximity_charger",
      "dimensions": { "width": 32, "height": 24 },
      "renderFunction": "drawCoralCrusher",
      "animations": {
        "patrol": { "fps": 12 },
        "alert": { "duration": 0.40, "pincerSnap": true },
        "charge": { "fps": 35, "speed": 280 },
        "dazed": { "duration": 2.2, "starOrbit": true }
      }
    }
  ],
  "bosses": [
    {
      "id": "ancient_tide_golem",
      "name": "The Ancient Tide Golem",
      "dimensions": { "width": 64, "height": 74 },
      "renderFunction": "drawAncientTideGolem",
      "phases": 3,
      "states": [
        "idle",
        "stride",
        "ground_slam",
        "boulder_throw",
        "water_jet_barrage",
        "enraged_charge",
        "vulnerable_kneel",
        "pacified_bow"
      ]
    }
  ],
  "npcs": [
    {
      "id": "coralia_diver",
      "name": "Coralia the Pearl Diver",
      "level": 1,
      "dimensions": { "width": 18, "height": 26 },
      "renderFunction": "drawCoralia"
    },
    {
      "id": "barnaby_navigator",
      "name": "Barnaby the Navigator",
      "level": 2,
      "dimensions": { "width": 28, "height": 26 },
      "renderFunction": "drawBarnaby"
    },
    {
      "id": "ancient_beacon_keeper",
      "name": "Ancient Beacon Keeper",
      "level": 5,
      "dimensions": { "width": 28, "height": 36 },
      "renderFunction": "drawBeaconKeeper"
    }
  ],
  "collectibles": [
    {
      "id": "sun_pearl",
      "name": "Sun Pearl",
      "dimensions": { "width": 14, "height": 14 },
      "renderFunction": "drawSunPearl",
      "orbitingSparkles": 3,
      "points": 50
    },
    {
      "id": "nautilus_shell",
      "name": "Golden Nautilus Shell",
      "dimensions": { "width": 14, "height": 12 },
      "renderFunction": "drawNautilusShell",
      "points": 20
    },
    {
      "id": "lore_medallion",
      "name": "Lore Medallion",
      "dimensions": { "width": 16, "height": 16 },
      "renderFunction": "drawLoreMedallion",
      "points": 500
    }
  ],
  "environmentProps": [
    {
      "id": "lighthouse",
      "name": "Ancient Lighthouse",
      "dimensions": { "width": 48, "height": 96 },
      "renderFunction": "drawLighthouse",
      "states": ["dormant", "activated"]
    },
    {
      "id": "waystone",
      "name": "Runic Waystone Checkpoint",
      "dimensions": { "width": 20, "height": 42 },
      "renderFunction": "drawWaystone",
      "states": ["dormant", "attuned"]
    },
    {
      "id": "cloud_ledge",
      "name": "Dissolving Cloud Ledge",
      "dimensions": { "width": 64, "height": 12 },
      "renderFunction": "drawCloudLedge",
      "dissolveTime": 1.0,
      "reappearTime": 2.0
    },
    {
      "id": "updraft",
      "name": "Coastal Updraft",
      "dimensions": { "width": 32, "height": 160 },
      "renderFunction": "drawUpdraft",
      "liftVelocity": -220
    }
  ],
  "ui": {
    "fontFamily": "'Fredoka', 'Nunito', system-ui, sans-serif",
    "hud": {
      "heart": { "width": 24, "height": 24, "renderFunction": "drawHUDHeart" },
      "pearlBadge": { "background": "rgba(10, 22, 16, 0.75)", "border": "#FFD166" }
    },
    "dialogue": {
      "width": 560,
      "height": 110,
      "backplate": "#0A1610",
      "border": "#00F5D4",
      "maxCharsPerLine": 48,
      "maxLinesPerPage": 3
    },
    "bossBar": {
      "width": 320,
      "height": 18,
      "border": "#264653",
      "segmentColors": ["#FFD166", "#00F5D4", "#00F5D4"]
    }
  }
}
