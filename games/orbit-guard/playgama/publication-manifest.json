{
  "title": "Orbit Guard",
  "id": "orbit-guard",
  "version": "1.0.0",
  "description": "Defend the Celestial Aegis planetary core! Summon orbital sentinels, merge identical units to ascend power tiers, and repel endless waves of void invaders in this mobile-first circular merge tower defense.",
  "howToPlay": "Tap or drag to buy and merge identical same-tier sentinels. Sentinels auto-attack invaders along their circular spiral path. Survive waves, defeat massive multi-phase bosses, upgrade workshop tech, and trigger Overcharge Surge!",
  "orientation": "portrait",
  "resolution": {
    "width": 450,
    "height": 720,
    "aspectRatio": "9:16",
    "scalable": true
  },
  "genre": "Strategy / Merge / Tower Defense / Auto-Battle",
  "storage": {
    "key": "orbit_guard_save_v1",
    "type": "cloud_with_local_fallback"
  },
  "leaderboards": [
    {
      "id": "orbit_guard_high_score",
      "isMain": true,
      "name": "Global High Score"
    }
  ],
  "audio": {
    "synthesized": true,
    "muteControlOnScreen": true,
    "autoPauseOnHidden": true
  },
  "dependencies": {
    "externalCdn": false,
    "offlineCapable": true
  },
  "compliance": {
    "originalIP": true,
    "zeroTrackers": true,
    "playgamaSdkReady": true
  },
  "advertisement": {
    "banners": {
      "supported": true,
      "placements": ["title_screen", "workshop_modal", "pause_screen", "game_over_screen"]
    },
    "rewarded": {
      "supported": true,
      "placements": [
        { "id": "airdrop_gold", "reward": "+120 Gold Supply Drop", "location": "in_game_hud" },
        { "id": "workshop_grant", "reward": "+100 Gold Tech Grant", "location": "workshop_modal" },
        { "id": "core_revive", "reward": "Revive Core (+50% HP) and continue run", "location": "game_over_modal" },
        { "id": "double_gold", "reward": "2x Run Gold Bonus", "location": "game_over_modal" }
      ]
    },
    "interstitial": {
      "supported": true,
      "placements": ["boss_wave_clear", "run_retry"]
    }
  }
}
